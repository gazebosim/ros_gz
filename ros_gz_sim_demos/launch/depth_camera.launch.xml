<launch>
  <gz_server
    world_sdf_file="depth_camera_sensor.sdf"
    use_composition="True"
    create_own_container="True" />
  <ros_gz_bridge
    bridge_name="ros_gz_bridge"
    config_file="$(find-pkg-share ros_gz_sim_demos)/config/depth_camera.yaml"
    use_composition="True" />
  <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share ros_gz_sim_demos)/rviz/depth_camera.rviz" />
  <executable cmd="gz sim -g" />
</launch>
